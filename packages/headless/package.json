{
  "name": "@codexydsh/headless",
  "description": "The dsh one-shot bundle: a direct core Agent/Session runner over dsh-base with no Host, HTTP, or browser layer",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5 || 1.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent-default-model": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@codexydsh/delegation": "workspace:*",
    "@codexydsh/runtime": "workspace:*",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-cmdline": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.4 || 3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@codexydsh/runtime-testkit": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@codexydsh/delegation": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
