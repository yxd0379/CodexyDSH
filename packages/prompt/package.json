{
  "name": "@codexydsh/prompt",
  "description": "Codex-derived coding prompt and runtime environment for the Codexful application",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./recap": {
      "types": "./lib/types/recap.d.ts",
      "default": "./lib/recap.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT AND Apache-2.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "@codexydsh/runtime": "workspace:*",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm-retry": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@codexydsh/approval": "workspace:*",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.4 || 3.18.5-alpha.1"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@codexydsh/bridges": "workspace:*",
    "@codexydsh/compaction": "workspace:*",
    "@codexydsh/retry": "workspace:*",
    "@codexydsh/delegation": "workspace:*",
    "@codexydsh/prompt-registry": "workspace:*"
