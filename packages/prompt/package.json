  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@codexydsh/runtime": "workspace:*",
    "@codexydsh/runtime-testkit": "workspace:*",
    "@deepseek-ai/dsh-compaction": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm-retry": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-alpha.2",
