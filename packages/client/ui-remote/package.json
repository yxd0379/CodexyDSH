{
  "name": "@deepseek-ai/dsh-client-ui-remote",
  "version": "0.2.1-rc.2",
  "description": "Unified workspace navigation over isolated native Remote Web clients",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./package.json": "./package.json"
  },
  "dsh": { "client": { "platform": "web", "inject": [
    "@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-api-session-controller",
    "@deepseek-ai/dsh-api-workspace-controller", "@deepseek-ai/dsh-client-locale",
    "@deepseek-ai/dsh-client-store", "@deepseek-ai/dsh-client-shortcuts", "@deepseek-ai/dsh-client-ui-layout",
    "@deepseek-ai/dsh-client-ui-primitives", "@deepseek-ai/dsh-client-ui-session",
    "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-workspace",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse"
  ] } },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "files": ["lib"],
  "license": "MIT",
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:~" },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@codexydsh/remote": "workspace:*",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-api-remotes": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-api-workspace-controller": "workspace:*",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-client-locale": "workspace:*",
    "@deepseek-ai/dsh-client-store": "workspace:*",
    "@deepseek-ai/dsh-client-shortcuts": "workspace:*",
    "@deepseek-ai/dsh-client-ui-layout": "workspace:*",
    "@deepseek-ai/dsh-client-ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session": "workspace:*",
    "@deepseek-ai/dsh-client-ui-settings": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "workspace:*",
    "@deepseek-ai/dsh-client-ui-workspace": "workspace:*",
    "@deepseek-ai/dsh-client-ui-directory-picker-browse": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "react": "^18.2.0",
    "zod": "^4.4.3"
  }
}
