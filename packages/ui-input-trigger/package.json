{
  "name": "@codexydsh/ui-input-trigger",
  "description": "Input trigger pipeline: '/' and '@' detection, candidate menu, pick routing to registered sources",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@codexydsh/ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer"
      ],
      "platform": "web"
    }
  },
  "scripts": {},
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "react": "^18.2.0",
    "clsx": "^2.0.0",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-file-reference": "0.2.0-rc.2 || 0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "@codexydsh/ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@codexydsh/ui-primitives": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-file-reference": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-values": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.2",
    "clsx": "^2.0.0",
    "@codexydsh/runtime": "workspace:*",
    "@codexydsh/test-support": "workspace:*"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@codexydsh/ui-primitives": "workspace:*",
    "@codexydsh/ui-conversation": "workspace:*"
  }
}
