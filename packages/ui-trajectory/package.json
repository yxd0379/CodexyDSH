{
  "name": "@codexydsh/ui-trajectory",
  "description": "Trajectory event ledger with an interactive timing overview: pure-consumer plugin registering into the conversation ViewMap (no service)",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@codexydsh/ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ],
      "platform": "web"
    }
  },
  "scripts": {},
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "react": "^18.2.0",
    "@tanstack/react-virtual": "^3.14.9",
    "diff": "^9.0.0",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2 || 0.2.1-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "@codexydsh/ui-primitives": "workspace:*",
    "@codexydsh/ui-conversation": "workspace:*",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.2",
    "@codexydsh/ui-chat": "workspace:*",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-attachment": "0.2.1-alpha.2",
    "@tanstack/react-virtual": "^3.14.9",
    "diff": "^9.0.0",
    "@codexydsh/runtime": "workspace:*",
    "@codexydsh/test-support": "workspace:*"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@codexydsh/ui-primitives": "workspace:*",
    "@codexydsh/ui-conversation": "workspace:*",
    "@codexydsh/runtime": "workspace:*"
  }
}
