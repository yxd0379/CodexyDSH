{
  "name": "@codexydsh/ui-skill",
  "description": "Web skill references and the dedicated skill tool row",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@codexydsh/ui-tool",
        "@codexydsh/ui-input-trigger",
        "@codexydsh/api-remotes",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {},
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2 || 0.2.1-alpha.2",
    "@deepseek-ai/schemastery": "3.18.4 || 3.18.5-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "@codexydsh/ui-primitives": "workspace:*",
    "@codexydsh/ui-input-trigger": "workspace:*",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "@codexydsh/ui-tool": "workspace:*",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.2",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.2",
    "@codexydsh/runtime": "workspace:*",
    "@codexydsh/test-support": "workspace:*",
    "@codexydsh/api-remotes": "workspace:*"
  },
  "files": [
    "lib"
  ],
  "dependencies": {
    "@codexydsh/ui-primitives": "workspace:*",
    "@codexydsh/ui-tool": "workspace:*",
    "@codexydsh/ui-input-trigger": "workspace:*"
  }
}
