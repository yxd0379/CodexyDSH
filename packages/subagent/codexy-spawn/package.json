{
  "name": "@codexydsh/spawn",
  "description": "In-process spawn subagent backend: runs a fresh child agent on ctx.agents",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@codexydsh/delegation": "workspace:*",
    "@codexydsh/delegation-driver": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@codexydsh/runtime": "workspace:*",
    "@codexydsh/runtime-testkit": "workspace:*",
    "@deepseek-ai/dsh-bash-local": "workspace:*",
    "@deepseek-ai/dsh-subprocess-local": "workspace:*",
    "@deepseek-ai/dsh-llm-deepseek": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@codexydsh/delegation": "workspace:*",
    "@codexydsh/delegation-driver": "workspace:*",
    "@deepseek-ai/dsh-tool-bash": "workspace:*",
    "@deepseek-ai/dsh-tool-subagent": "workspace:*",
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~"
  }
}
